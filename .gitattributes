# Store LF in the repository; check out native line endings on Windows.
* text=auto

# Always LF in the working tree too — these are parsed or executed on Linux CI.
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.cjs  text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Binary assets — never convert.
*.png binary
*.ico binary
*.jpg binary
*.woff2 binary
